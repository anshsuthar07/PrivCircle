# Local Docker defaults. Use rediss:// Upstash and a pooled Neon URL in production.
REDIS_URL=redis://127.0.0.1:56379
DATABASE_URL=postgresql://private_share:private_share@127.0.0.1:55432/private_share
# Optional direct Neon URL used by schema migrations instead of DATABASE_URL.
DIRECT_DATABASE_URL=
ROOM_TOKEN_SECRET=replace-with-at-least-32-random-characters
SESSION_PEPPER=replace-with-a-separate-random-secret
APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_WS_URL=ws://localhost:1234
REALTIME_PORT=1234

# --- Temporary room documents (optional) ---
# Vercel Blob read-write token. Without it, file sharing reports itself as
# unavailable and the rest of the room is unaffected.
BLOB_READ_WRITE_TOKEN=
# Shared secret for the scheduled cleanup endpoint. Vercel Cron sends it as
# `Authorization: Bearer <CRON_SECRET>`. Required in production when blob
# storage is configured. Use at least 32 random characters.
CRON_SECRET=
# Optional tuning. Defaults: 20 files per room, 1 GiB per room, 100 rows per
# cleanup pass. The 300 MB per-file ceiling is fixed and not configurable.
ROOM_DOCUMENT_LIMIT=
ROOM_DOCUMENT_TOTAL_BYTES=
DOCUMENT_CLEANUP_BATCH=
