{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "fluid": true,
  "functions": {
    "app/api/ws/[path]/route.ts": {
      "maxDuration": 300
    },
    "app/api/cron/documents/route.ts": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron/documents",
      "schedule": "17 3 * * *"
    }
  ]
}
